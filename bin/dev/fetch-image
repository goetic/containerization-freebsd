#!/usr/bin/env sh
#
# Downloads FreeBSD's VM image, the pinned guest bundle and the userland into
# the integration suites' cache. The suites read the cache but never fill it.
# Files already in the cache are not downloaded again.

set -e

root="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$root"

exec cargo run --quiet -p containerization-freebsd-test --bin fetch-image
