#!/usr/bin/env sh
#
# Downloads FreeBSD's VM image, the pinned guest bundle and the userland into
# the integration suites' cache, skipping files already there. The suites read
# these files but never download them.

set -e

root="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$root"

exec cargo run --quiet -p containerization-freebsd-test --bin fetch-image
