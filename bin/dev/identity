#!/usr/bin/env sh
#
# Prints the hash of the codesigning identity that belongs to a team id.
#
# `codesign --sign` matches on the certificate's common name, which does not
# hold the team id; the team id is in the OU. So this script reads each
# certificate's subject.

set -e

team="${1:?usage: bin/dev/identity <team-id>}"

security find-identity -v -p codesigning |
  sed -n 's/^ *[0-9]*) \([0-9A-F][0-9A-F]*\) "\(.*\)"$/\1 \2/p' |
  while read -r hash name; do
    # Split both openssl output styles, `subject=CN=…, OU=…` and
    # `subject= /CN=…/OU=…`, into one field per line.
    organizational_unit="$(
      security find-certificate -c "$name" -p 2>/dev/null |
        openssl x509 -noout -subject 2>/dev/null |
        tr ',/' '\n\n' |
        sed -n 's/^ *OU *= *//p' |
        head -1
    )"

    if [ "$organizational_unit" = "$team" ]; then
      printf '%s\n' "$hash"
      break
    fi
  done
