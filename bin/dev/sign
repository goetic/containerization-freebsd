#!/usr/bin/env sh
#
# Signs a binary with the `com.apple.security.virtualization` entitlement,
# which Virtualization.framework requires. Every rebuild drops the signature.
#
# DEVELOPMENT_TEAM selects that team's identity. Without it, the binary is
# signed ad hoc. That is enough for the entitlement, but each build gets a new
# code identity, so anything keyed to the identity prompts again.

set -e

binary="${1:?usage: bin/dev/sign <binary>}"
root="$(cd "$(dirname "$0")/../.." && pwd)"

if [ -n "$DEVELOPMENT_TEAM" ]; then
  identity="$("$root/bin/dev/identity" "$DEVELOPMENT_TEAM")"

  if [ -z "$identity" ]; then
    echo "bin/dev/sign: no codesigning identity belongs to team $DEVELOPMENT_TEAM" >&2
    echo "the identities this machine holds are:" >&2
    security find-identity -v -p codesigning >&2
    exit 1
  fi
else
  identity="-"
fi

codesign --force --entitlements "$root/virtualization.entitlements" --sign "$identity" --timestamp=none "$binary"
