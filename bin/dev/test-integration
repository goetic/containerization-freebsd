#!/usr/bin/env bash
#
# Runs the integration suites: builds their test binaries, signs them, and
# runs them.
#
# Virtualization checks the entitlement with `SecTaskCreateFromSelf`, so the
# test binary itself must carry `com.apple.security.virtualization`. Cargo
# builds it unsigned, so this script signs it.
#
# Extra arguments are passed to nextest, for example to run a single test:
#
#   bin/dev/test-integration -E 'test(restores)'
#
# Pass only options that select and run tests. An option that changes the
# build (`--release`, `--cargo-profile`, `--features`) makes nextest rebuild
# unsigned binaries, which Virtualization refuses.

set -euo pipefail

root="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$root"

package=containerization-freebsd-test
targets=()
for suite in crates/$package/tests/*.rs; do
  [ -e "$suite" ] || continue
  targets+=(--test "$(basename "$suite" .rs)")
done

if [ "${#targets[@]}" -eq 0 ]; then
  echo "bin/dev/test-integration: there are no suites in crates/$package/tests/" >&2
  exit 1
fi

# `--message-format=json` writes JSON messages, compiler diagnostics among
# them, to stdout and cargo's progress to stderr, so this collects the
# binaries' paths while progress shows as usual. The filter drops diagnostics.
binaries="$(
  cargo test -p "$package" "${targets[@]}" --no-run --message-format=json |
    python3 -c 'import json, sys
for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    message = json.loads(line)
    if message.get("executable") and message.get("profile", {}).get("test"):
        print(message["executable"])'
)"

if [ -z "$binaries" ]; then
  echo "bin/dev/test-integration: cargo built no test binaries" >&2
  exit 1
fi

while IFS= read -r binary; do
  "$root/bin/dev/sign" "$binary"
done <<<"$binaries"

exec cargo nextest run --color always -p "$package" "${targets[@]}" "$@"
