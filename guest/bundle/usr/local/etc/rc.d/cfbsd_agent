#!/bin/sh
#
# PROVIDE: cfbsd_agent
# REQUIRE: FILESYSTEMS
# BEFORE: LOGIN
# KEYWORD: shutdown
#
# The guest agent, which serves the host over /dev/ttyV0.0. daemon(8)
# restarts the agent whenever it exits, as it does when the console closes.
# -f redirects daemon's stdio to /dev/null, so it doesn't keep open an
# inherited pipe whose reader would never see EOF.
#
# cfbsd_agent_enable (bool): "NO" by default.

. /etc/rc.subr

name=cfbsd_agent
rcvar=cfbsd_agent_enable

load_rc_config $name

: "${cfbsd_agent_enable:=NO}"

pidfile="/var/run/${name}.pid"
procname=/usr/sbin/daemon
command=/usr/sbin/daemon
command_args="-f -r -t ${name} -P ${pidfile} -o /var/log/${name}.log /usr/local/sbin/containerization-freebsd-agent"

run_rc_command "$1"
