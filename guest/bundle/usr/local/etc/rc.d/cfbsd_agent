#!/bin/sh
#
# PROVIDE: cfbsd_agent
# REQUIRE: FILESYSTEMS
# BEFORE: LOGIN
# KEYWORD: shutdown
#
# The guest agent, serving the host over /dev/ttyV0.0. daemon(8) restarts it
# whenever it exits, as it does when the console closes.
#
# cfbsd_agent_enable (bool): "NO" by default.

. /etc/rc.subr

name=cfbsd_agent
rcvar=cfbsd_agent_enable

load_rc_config $name

: "${cfbsd_agent_enable:=NO}"

pidfile="/var/run/${name}.pid"
procname=/usr/sbin/daemon
command=/usr/sbin/daemon
command_args="-r -t ${name} -P ${pidfile} -o /var/log/${name}.log /usr/local/sbin/containerization-freebsd-agent"

run_rc_command "$1"
