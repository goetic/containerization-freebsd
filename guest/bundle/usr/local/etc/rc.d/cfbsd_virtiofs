#!/bin/sh
#
# PROVIDE: cfbsd_virtiofs
# REQUIRE: FILESYSTEMS
# BEFORE: cfbsd_agent
#
# Loads the guest bundle's patched virtiofs modules, starting with its
# fusefs. loader.conf can't do this: the loader loads modules in no fixed
# order, and loading virtiofs first would pull in the stock fusefs from
# /boot/kernel, which kern.module_path searches first. Loading virtiofs pulls
# in vtfs.

. /etc/rc.subr

name=cfbsd_virtiofs
start_cmd=cfbsd_virtiofs_start
stop_cmd=:

cfbsd_virtiofs_start()
{
	kldstat -q -m fusefs || kldload /boot/modules/fusefs.ko
	kldstat -q -m virtiofs || kldload virtiofs
}

load_rc_config $name
run_rc_command "$1"
